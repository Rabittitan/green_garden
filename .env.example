APP_NAME="GreenGarden Shop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# GreenGarden CHỈ chạy trên MySQL >= 8.0.16 hoặc MariaDB >= 10.4 (cần CHECK constraint, cột sinh, khóa dòng)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=green_life
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# database: cần chạy "php artisan queue:work" để gửi email; sync: gửi ngay trong request (đơn giản, chậm hơn)
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===== GreenGarden Shop =====
# Thanh toán online: fake (CHỈ dùng khi APP_ENV=local, tự giả lập cổng) | vnpay (sandbox / thật)
# Để trống hoặc cấu hình thiếu ở production => thanh toán online tự TẮT, COD vẫn chạy.
PAYMENT_GATEWAY=fake
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Chuyển khoản: để trống số tài khoản => ẩn phương thức chuyển khoản
SHOP_BANK_NAME=Vietcombank
SHOP_BANK_ACCOUNT_NO=
SHOP_BANK_ACCOUNT_NAME="GREENGARDEN SHOP"

SHOP_SHIPPING_FEE=30000
SHOP_FREE_SHIPPING_MIN=500000
SHOP_RETURN_ADDRESS="GreenGarden Shop - 12 Nguyễn Huệ, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh"

# Thông tin người bán in trên hóa đơn bán lẻ (để trống dòng nào thì hóa đơn không in dòng đó)
SHOP_SELLER_NAME="GreenGarden Shop"
SHOP_SELLER_ADDRESS=
SHOP_SELLER_PHONE=
SHOP_SELLER_EMAIL=
SHOP_SELLER_TAX_CODE=

# Production: SESSION_SECURE_COOKIE mặc định bật khi APP_ENV=production (cookie chỉ gửi qua HTTPS)

# Đứng sau nginx/Cloudflare/load balancer: khai báo IP/dải IP của proxy để lấy đúng IP khách và nhận ra HTTPS.
# VD: TRUSTED_PROXIES=127.0.0.1   |   "*" chỉ khi app KHÔNG nhận kết nối trực tiếp từ internet. Trống = không tin proxy nào.
TRUSTED_PROXIES=

# ----- Checklist production (xem docs/H7-van-hanh.md) -----
# APP_ENV=production  APP_DEBUG=false  APP_URL=https://ten-mien-that  LOG_STACK=daily  LOG_LEVEL=warning
# MAIL_MAILER=smtp + MAIL_*   PAYMENT_GATEWAY=vnpay + VNPAY_*   (fake bị TẮT tự động ngoài local/testing)
